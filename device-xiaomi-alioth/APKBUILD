# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: nasaarmas <nasarmas@tlen.pl>
pkgname=device-xiaomi-alioth
pkgdesc="Xiaomi Poco F3"
pkgver=5
pkgrel=12
url="https://postmarketos.org"
license="MIT BSD-3-Clause"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8250-alioth
	alsa-ucm-conf
	bootmac
	hexagonrpcd>=0.3.2-r3
	make-dynpart-mappings
	mesa-vulkan-freedreno
	mkbootimg
	postmarketos-base
	qbootctl
	swclock-offset
	hexagonrpcd-systemd
	firmware-xiaomi-alioth
	firmware-qcom-adreno-a650
	linux-firmware-qcom
	linux-firmware-qca
	linux-firmware-ath11k
	bash
	bluez
	iproute2
	kmod
	modemmanager=1.25.95_git20261005-r4
	networkmanager
	python3
	qmi-utils
	qrtr
	qrtr-libs
	zstd-libs
"

makedepends="
	devicepkg-dev
	meson
	qrtr-dev
	zstd-dev
"
source="
	81-libssc-xiaomi-alioth.rules
    alsa-ucm-conf/alioth.conf
    alsa-ucm-conf/HiFi.conf
	deviceinfo
	hexagonrpcd.confd
	modules-initfs
    wifi-powersave.conf
	alioth-bluetooth-init.sh
	alioth-bluetooth.service
	bluetooth-modules.conf
	modem-services/77-mm-ignore-sdx55-extra.rules
	modem-services/77-mm-sdx55-qrtr.rules
	modem-services/alioth-modem-firmware.service
	modem-services/alioth-modem-firmware.sh
	modem-services/alioth-modem.service
	modem-services/alioth-sim-provision
	modem-services/alioth-switch-sim
	modem-services/data_up.py
	modem-services/diagprobe.py
	modem-services/efs_srv.py
	modem-services/modem-modules.conf
	modem-services/modem-up.sh
	modem-services/sahara_srv.py
	modem-services/tqftpserv.service
	modem-services/alioth-sdx55.conf
	https://github.com/linux-msm/tqftpserv/archive/v1.3/tqftpserv-v1.3.tar.gz
	tqftpserv-alioth-qrtr-instance.diff
"

prepare() {
	default_prepare
	cd "$srcdir/tqftpserv-1.3"
	patch -p1 -i "$srcdir/tqftpserv-alioth-qrtr-instance.diff"
}

build() {
	devicepkg_build $startdir $pkgname
	cd "$srcdir/tqftpserv-1.3"
	abuild-meson . output
	meson compile -C output
}

package() {
    devicepkg_package $startdir $pkgname

	# device-specific alsa ucm conf
	install -Dm644 "$srcdir/alioth.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/alioth.conf"

	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/HiFi.conf"

	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
	ln -s ../../Xiaomi/alioth/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-alioth.conf"
	ln -s ../../Xiaomi/alioth/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/xiaomialioth.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/xiaomialioth" "$pkgdir/usr/share/alsa/ucm2/conf.d/xiaomi-alioth"
	ln -s ../../Xiaomi/alioth/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/xiaomialioth/xiaomialioth.conf"
	ln -s ../../Xiaomi/alioth/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/xiaomi-alioth/xiaomi-alioth.conf"

    install -Dm644 "$srcdir/81-libssc-xiaomi-alioth.rules" \
        "$pkgdir/etc/udev/rules.d/81-libssc-xiaomi-alioth.rules"
	
    install -Dm644 "$srcdir/hexagonrpcd.confd" \
		"$pkgdir/usr/share/hexagonrpcd/hexagonrpcd-sdsp.conf"

    # makes the device more responsive through ssh
    install -Dm644 "$srcdir/wifi-powersave.conf" \
        "$pkgdir/etc/NetworkManager/conf.d/wifi-powersave.conf"

	install -Dm755 "$srcdir/alioth-bluetooth-init.sh" \
		"$pkgdir/usr/bin/alioth-bluetooth-init.sh"
	install -Dm644 "$srcdir/alioth-bluetooth.service" \
		"$pkgdir/etc/systemd/system/alioth-bluetooth.service"
	install -Dm644 "$srcdir/bluetooth-modules.conf" \
		"$pkgdir/etc/modules-load.d/bluetooth.conf"

	install -Dm755 "$srcdir/alioth-modem-firmware.sh" \
		"$pkgdir/usr/bin/alioth-modem-firmware.sh"
	install -Dm644 "$srcdir/alioth-modem-firmware.service" \
		"$pkgdir/etc/systemd/system/alioth-modem-firmware.service"
	install -Dm644 "$srcdir/alioth-modem.service" \
		"$pkgdir/etc/systemd/system/alioth-modem.service"
	install -Dm755 "$srcdir/tqftpserv-1.3/output/tqftpserv" \
		"$pkgdir/usr/bin/tqftpserv"
	install -Dm644 "$srcdir/tqftpserv-1.3/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/tqftpserv-COPYING"
	install -Dm644 "$srcdir/tqftpserv.service" \
		"$pkgdir/etc/systemd/system/tqftpserv.service"
	install -Dm644 "$srcdir/modem-modules.conf" \
		"$pkgdir/etc/modules-load.d/modem.conf"
	install -Dm644 "$srcdir/alioth-sdx55.conf" \
		"$pkgdir/etc/modprobe.d/alioth-sdx55.conf"

	for script in data_up.py diagprobe.py efs_srv.py sahara_srv.py; do
		install -Dm755 "$srcdir/$script" \
			"$pkgdir/usr/bin/$script"
	done
	for script in alioth-sim-provision alioth-switch-sim modem-up.sh; do
		install -Dm755 "$srcdir/$script" \
			"$pkgdir/usr/bin/$script"
	done
	install -Dm644 "$srcdir/77-mm-ignore-sdx55-extra.rules" \
		"$pkgdir/etc/udev/rules.d/77-mm-ignore-sdx55-extra.rules"
	install -Dm644 "$srcdir/77-mm-sdx55-qrtr.rules" \
		"$pkgdir/etc/udev/rules.d/77-mm-sdx55-qrtr.rules"

	mkdir -p "$pkgdir/etc/systemd/system/multi-user.target.wants"
	for unit in alioth-bluetooth.service alioth-modem-firmware.service alioth-modem.service tqftpserv.service; do
		ln -sfn "../$unit" "$pkgdir/etc/systemd/system/multi-user.target.wants/$unit"
	done
}


